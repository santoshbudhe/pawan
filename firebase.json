{
  "firestore": {
    "database": "pawan",
    "location": "asia-south1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/procedures/sdr/**",
      "assets/home/combined-care/pathway-neuro-care.webp",
      "assets/home/combined-care/pathway-spasticity-tightness.webp",
      "assets/home/combined-care/pathway-team-collaboration.webp",
      "assets/homepage/what-is-spasticity-illustration.png",
      "assets/homepage/understanding-spasticity/**",
      "assets/success-stories/patient-01/**",
      "favicon.png"
    ],
    "redirects": [
      {
        "regex": "^/procedures/selective-dorsal-rhizotomy/?$",
        "destination": "/procedures/deformity-correction-surgery",
        "type": 301
      },
      {
        "regex": "^/success-stories/closer-to-his-dream-after-combined-treatment/?$",
        "destination": "/procedures/deformity-correction-surgery",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "hosting": {
      "port": 5000
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
